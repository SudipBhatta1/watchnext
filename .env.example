# Copy to .env and fill in. NEVER commit .env to GitHub.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0

# Local XAMPP defaults:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=watchnext
DB_USER=root
DB_PASSWORD=

# Hosted MySQL (Aiven): copy host/port/user/password/database from the service page
# and turn SSL on:
# DB_HOST=mysql-xxxx-yourname.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your-password
# DB_NAME=watchnext   (the setup script creates it if it does not exist)
# DB_SSL=1

# Optional: choose your own seed-account passwords for setup_remote_db.py
# (otherwise strong random ones are generated and printed once)
# SEED_ADMIN_PASSWORD=
# SEED_MODERATOR_PASSWORD=
# SEED_USER_PASSWORD=
